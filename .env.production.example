# Server-side only. Enter real values in Vercel Sensitive environment variables.
# Never commit a real environment file or prefix these secrets with VITE_.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3-contributor
META_MAX_TOKENS=800
META_REASONING_EFFORT=minimal
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TIESUA_STORE_NAMESPACE=tiesua-production
ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app
TIESUA_DIAGNOSTICS_TOKEN=
# Owner-controlled optional lifetime ceilings. 0 disables the application ceiling.
TIESUA_PUBLIC_MAX_CALLS=0
TIESUA_PUBLIC_MAX_OUTPUT_TOKENS=0
# Shared abuse throttling, not a per-lesson limit.
TIESUA_TUTOR_RATE_PER_MIN=30
TIESUA_TUTOR_GLOBAL_RATE_PER_MIN=120
# Optional provider prices for estimates. Leave unset until checked.
# META_INPUT_USD_PER_MILLION=
# META_OUTPUT_USD_PER_MILLION=
# Frontend project only: VITE_API_BASE=https://YOUR-BACKEND.vercel.app
